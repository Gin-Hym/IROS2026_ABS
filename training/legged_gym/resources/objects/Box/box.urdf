<?xml version="1.0"?>
<robot name="hollow_foam_box">

    <link name="box">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.05"/>
            
            <inertia 
                ixx="0.07" ixy="0.0" ixz="0.0" 
                iyy="0.07" iyz="0.0" 
                izz="0.07"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.6 0.6 0.6"/>
            </geometry>
            <material name="foam_white">
                <color rgba="0.9 0.9 0.9 1.0"/> </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.6 0.6 0.6"/>
            </geometry>
        </collision>
    </link>

</robot>